# =============================================================================
# Student setup — copy this file to .env and follow README.md
# =============================================================================
#
# Quick start (after clone):
#   npm install
#   npm run env:init          → creates .env from this file
#   npm run jwt:secret        → copy printed JWT_SECRET into .env
#   (edit DATABASE_URL + BOOTSTRAP_ADMIN_* below if needed)
#   npm run setup             → tables + permissions + wallets + superuser
#   npm run dev               → http://localhost:3000
#
# Windows copy without npm:  copy .env.example .env
# Mac/Linux:                 cp .env.example .env
# =============================================================================

# MySQL (XAMPP default: user root, no password, database zakat_db)
DATABASE_URL="mysql://root:@localhost:3306/zakat_db"

# Run: npm run jwt:secret — then paste the printed line here (required)
JWT_SECRET="paste-here-after-running-npm-run-jwt-secret"

# First admin login (change for your machine; not uploaded to GitHub)
BOOTSTRAP_ADMIN_NAME="Super Admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"

# Optional — used only on first seed if nisab table is empty
# NISAB_VALUE="1000"
# GOLD_PRICE_PER_GRAM="70"

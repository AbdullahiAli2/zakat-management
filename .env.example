# --- Student setup (5 steps) ---
# 1) Duplicate this file in File Explorer: copy .env.example -> rename to .env
#    (Or in terminal: copy .env.example .env)
# 2) Edit DATABASE_URL if your MySQL user/password/database is different
# 3) Run: npm run jwt:secret   then paste the result into JWT_SECRET below
# 4) npm install
# 5) npm run setup
# 6) npm run dev

DATABASE_URL="mysql://root:@localhost:3306/zakat_db"

# Paste output from: npm run jwt:secret
JWT_SECRET="paste-here-after-running-npm-run-jwt-secret"

# Superuser login (you choose — used only on your computer)
BOOTSTRAP_ADMIN_NAME="Super Admin"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123!"
